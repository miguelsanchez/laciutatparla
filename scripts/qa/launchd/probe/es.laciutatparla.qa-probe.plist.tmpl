<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One-shot probe (arquitectura-agentes.md F2.8): can `claude -p` run from launchd, with no login
  session and the keychain locked? Same domain, user and environment as the daily job. It runs
  once when installed (RunAtLoad, no schedule) and writes its result to @STATE@/runs.jsonl.
  Install: bash scripts/qa/install_launchd.sh --probe · remove: --uninstall-probe
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>es.laciutatparla.qa-probe</string>

  <key>UserName</key>
  <string>@USER@</string>

  <key>ProgramArguments</key>
  <array>
    <string>@LCP_ROOT@/scripts/.venv/bin/python</string>
    <string>@LCP_ROOT@/scripts/qa/probe_claude.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@LCP_ROOT@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>USER</key>
    <string>@USER@</string>
    <key>LCP_ROOT</key>
    <string>@LCP_ROOT@</string>
    <key>LCP_QA_STATE</key>
    <string>@STATE@</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>@STATE@/logs/probe.log</string>
  <key>StandardErrorPath</key>
  <string>@STATE@/logs/probe.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
