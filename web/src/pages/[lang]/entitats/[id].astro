---
import Base from '../../../layouts/Base.astro';
import { t, formatDate } from '../../../i18n/index.ts';
import { getCatLabels, getSubLabels, getAmbitLabels } from '../../../utils/labels.ts';
import { withCanonicalEntitat } from '../../../utils/format.ts';
import { InterventionCard } from '../../../components/InterventionCard.tsx';
import { readData } from '../../../utils/data.ts';

export function getStaticPaths() {
  try {
    const entitats = readData('entitats.json');
    const langs = ['cas', 'val'];
    return langs.flatMap((lang: string) =>
      entitats.map((e: any) => ({ params: { lang, id: e.id } }))
    );
  } catch {
    return [];
  }
}

const { lang, id } = Astro.params as { lang: 'cas' | 'val'; id: string };
let entitat: any = null;
let intervencions: any[] = [];

try {
  const entitats = readData('entitats.json');
  entitat = entitats.find((e: any) => e.id === id);
  const all = readData('intervencions.json');
  intervencions = withCanonicalEntitat(all.filter((iv: any) => iv.entitat_id === id), entitats, lang);
} catch {}

const primaryName = lang === 'val' ? (entitat?.nom_val || entitat?.nom_cas) : (entitat?.nom_cas || entitat?.nom_val);
const alternateName = lang === 'val' ? entitat?.nom_cas : entitat?.nom_val;
const showAlternate = alternateName && alternateName !== primaryName;

const temesLabels: Record<string, string> = {
  urbanisme: t(lang, 'temes_urbanisme'), habitatge: t(lang, 'temes_habitatge'),
  medi_amb: t(lang, 'temes_medi_amb'), mobilitat: t(lang, 'temes_mobilitat'),
  esports: t(lang, 'temes_esports'), cultura: t(lang, 'temes_cultura'),
  educacio: t(lang, 'temes_educacio'), salut: t(lang, 'temes_salut'),
  seguretat: t(lang, 'temes_seguretat'), serveis_socials: t(lang, 'temes_serveis_socials'),
  participacio_ciutadana: t(lang, 'temes_participacio_ciutadana'),
  infraestructures: t(lang, 'temes_infraestructures'), economia: t(lang, 'temes_economia'),
  dana_emergencies: t(lang, 'temes_dana_emergencies'), patrimoni: t(lang, 'temes_patrimoni'),
  joventut: t(lang, 'temes_joventut'), gent_major: t(lang, 'temes_gent_major'),
  igualtat: t(lang, 'temes_igualtat'), barris: t(lang, 'temes_barris'),
  memoria_historica: t(lang, 'temes_memoria_historica'), agricultura: t(lang, 'temes_agricultura'),
  turisme: t(lang, 'temes_turisme'), altres: t(lang, 'temes_altres'),
  medi_ambient: t(lang, 'temes_medi_ambient'),
};
const tipusLabels: Record<string, string> = {
  av: t(lang, 'entitats_tipus_av'),
  plataforma: t(lang, 'entitats_tipus_plataforma'),
  ong: t(lang, 'entitats_tipus_ong'),
  sindical: t(lang, 'entitats_tipus_sindical'),
  cultural: t(lang, 'entitats_tipus_cultural'),
  educacio: t(lang, 'entitats_tipus_educacio'),
  esportiu: t(lang, 'entitats_tipus_esportiu'),
  empresa: t(lang, 'entitats_tipus_empresa'),
  particular: t(lang, 'entitats_tipus_particular'),
  altres: t(lang, 'entitats_tipus_altres'),
};
const cardLabels = {
  idioma_valenciano: t(lang, 'intervencio_idioma_valenciano'),
  idioma_castellano: t(lang, 'intervencio_idioma_castellano'),
  ver_texto: t(lang, 'intervencio_ver_texto'),
  ocultar_texto: t(lang, 'intervencio_ocultar_texto'),
  traduccion: t(lang, 'intervencio_traduccion_label'),
  original: t(lang, 'intervencio_original_label'),
  punts: t(lang, 'intervencio_punts'),
  en_representacio: t(lang, 'intervencio_en_representacio'),
  en_nom_de: t(lang, 'intervencio_en_nom_de'),
  ambit_labels: getAmbitLabels(lang),
};
---

<Base title={primaryName ?? id}>
  {!entitat ? (
    <p class="text-stone-400">{lang === 'val' ? 'Entitat no trobada.' : 'Entidad no encontrada.'}</p>
  ) : (
    <>
      <nav class="text-sm text-stone-400 mb-6">
        <a href={`/${lang}/entitats/`} class="hover:text-orange-600">{t(lang, 'entitats_title')}</a>
        <span class="mx-2">›</span>
        <span>{primaryName}</span>
      </nav>

      <div class="bg-white rounded-xl border border-stone-200 p-6 mb-8 shadow-sm">
        <h1 class="text-2xl font-bold text-stone-900 mb-1">{primaryName}</h1>
        {showAlternate && (
          <p class="text-stone-400 text-sm mb-2">{alternateName}</p>
        )}
        <div class="flex flex-wrap gap-3 text-sm text-stone-500">
          {entitat.barri && <span><span role="img" aria-hidden="true">📍</span> {entitat.barri}</span>}
          <span><span role="img" aria-hidden="true">🗣️</span> {entitat.num_intervencions} {t(lang, 'entitats_intervencions')}</span>
        </div>
      </div>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2">
        {intervencions.map((iv: any) => (
          <InterventionCard
            client:load
            iv={iv}
            lang={lang}
            showDate={true}
            labels={cardLabels}
            temes_labels={temesLabels}
            cat_labels={getCatLabels(lang)}
            sub_labels={getSubLabels(lang)}
            tipus_labels={tipusLabels}
            plens_path={`/${lang}/plens/`}
            entitats_path={`/${lang}/entitats/`}
            intervencions_path={`/${lang}/intervencions/`}
          />
        ))}
      </div>
    </>
  )}
</Base>
