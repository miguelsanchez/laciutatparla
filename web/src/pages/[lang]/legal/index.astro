  </div>
</Base>

<style>
  .legal {
    max-width: 48rem;
    margin: 0 auto;
  }

  .legal section {
    margin-bottom: 3rem;
  }

  .legal h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1c1917;
    border-bottom: 1px solid #e7e5e4;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .legal h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #292524;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .legal p {
    color: #57534e;
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .legal ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: #57534e;
  }

  .legal ul li {
    line-height: 1.75;
    margin-bottom: 0.25rem;
  }

  .legal a {
    color: #ea580c;
  }

  .legal a:hover {
    color: #c2410c;
  }

  .contact-box {
    background: #fafaf9;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 0.75rem 0;
    font-size: 0.9rem;
  }

  .contact-box p {
    margin-bottom: 0.25rem;
  }
</style>
