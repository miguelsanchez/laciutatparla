---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/index.ts';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const lang = 'cas';
const dataDir = resolve(process.cwd(), '..', 'data');
let plenos: any[] = [];
let mandats: any[] = [];
try { plenos = JSON.parse(readFileSync(`${dataDir}/plenos.json`, 'utf-8')); } catch {}
try { mandats = JSON.parse(readFileSync(`${dataDir}/mandats.json`, 'utf-8')); } catch {}

const mandatsById = Object.fromEntries(mandats.map((m: any) => [m.id, m]));
const plenosByMandat = new Map<string, any[]>();
for (const p of plenos) {
  const mid = p.mandat_id || 'desconegut';
  if (!plenosByMandat.has(mid)) plenosByMandat.set(mid, []);
  plenosByMandat.get(mid)!.push(p);
}

---

<Base title={t(lang, 'plens_title')}>
  <div class="flex items-center justify-between mb-6 gap-4">
    <h1 class="text-2xl font-bold text-stone-900">{t(lang, 'plens_title')}</h1>
    <button
      id="toggle-empty"
      class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-stone-200 bg-white text-stone-500 hover:border-orange-300 hover:text-orange-600 transition-all shrink-0"
      aria-pressed="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M7 8h10M11 12h2" />
      </svg>
      {t(lang, 'plens_solo_amb')}
    </button>
  </div>

  {[...plenosByMandat.entries()].map(([mandatId, mandatPlenos]) => {
    const mandat = mandatsById[mandatId];
    return (
      <section class="mb-10">
        <div class="flex items-baseline gap-3 mb-3 sticky top-12 z-40 bg-white border-l-4 border-l-orange-500 pl-3 pt-3 pb-2.5 -mx-1 px-1 shadow-[0_2px_8px_-2px_rgba(0,0,0,0.06)]">
          <h2 class="text-base font-semibold text-stone-800">
            {t(lang, 'plens_mandat')} {mandat?.legislatura ?? mandatId}
          </h2>
          {mandat && (
            <span class="text-sm text-stone-400">
              {t(lang, 'plens_alcalde')}: {mandat.alcalde_titol_cas} {mandat.alcalde}
            </span>
          )}
        </div>

        <div class="space-y-2">
          {mandatPlenos.map((pleno: any) => {
            if (pleno.num_intervencions > 0) {
              return (
                <a
                  href={`/${lang}/plens/${pleno.id}/`}
                  class="flex items-center gap-4 bg-white rounded-xl border border-stone-200 p-4 shadow-sm hover:border-orange-300 hover:shadow-md transition-all group"
                >
                  <div class="text-center min-w-[52px]">
                    <div class="text-xl font-bold text-stone-900 group-hover:text-orange-600 transition-colors leading-none">
                      {pleno.fecha.slice(8, 10)}
                    </div>
                    <div class="text-xs text-stone-400 uppercase mt-0.5">
                      {new Date(pleno.fecha + 'T12:00:00').toLocaleDateString('es-ES', { month: 'short' })}
                    </div>
                    <div class="text-xs text-stone-400">{pleno.fecha.slice(0, 4)}</div>
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                        pleno.tipo === 'ordinaria' ? 'bg-blue-100 text-blue-700'
                        : pleno.tipo === 'extraordinaria' ? 'bg-purple-100 text-purple-700'
                        : 'bg-red-100 text-red-700'
                      }`}>
                        {t(lang, `plens_${pleno.tipo}`)}
                      </span>
                      <span class={`text-xs ${pleno.acta_disponible ? 'text-green-600' : 'text-stone-400'}`}>
                        {pleno.acta_disponible ? t(lang, 'plens_acta_si') : t(lang, 'plens_acta_no')}
                      </span>
                    </div>
                    <p class="text-sm text-stone-600">
                      <span class="font-medium text-orange-600">{pleno.num_intervencions}</span>{' '}
                      {t(lang, 'plens_intervencions_count')}
                    </p>
                    {pleno.entitats_preview?.length > 0 && (
                      <p class="text-xs text-stone-400 mt-1 truncate">{pleno.entitats_preview.join(' · ')}</p>
                    )}
                  </div>

                  <span class="text-stone-300 group-hover:text-orange-400 transition-colors text-lg" aria-hidden="true">→</span>
                </a>
              );
            } else {
              return (
                <a
                  href={`/${lang}/plens/${pleno.id}/`}
                  class="flex items-center gap-3 rounded-lg border border-stone-100 bg-stone-50 px-4 py-2 opacity-50 hover:opacity-90 hover:border-stone-300 transition-all group"
                  data-empty="true"
                >
                  <div class="flex items-baseline gap-1.5 min-w-[60px]">
                    <span class="text-sm font-medium text-stone-500">{pleno.fecha.slice(8, 10)}</span>
                    <span class="text-xs text-stone-400 uppercase">
                      {new Date(pleno.fecha + 'T12:00:00').toLocaleDateString('es-ES', { month: 'short' })}
                    </span>
                  </div>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium shrink-0 ${
                    pleno.tipo === 'ordinaria' ? 'bg-blue-100 text-blue-700'
                    : pleno.tipo === 'extraordinaria' ? 'bg-purple-100 text-purple-700'
                    : 'bg-red-100 text-red-700'
                  }`}>
                    {t(lang, `plens_${pleno.tipo}`)}
                  </span>
                  <span class="text-xs text-stone-400 flex-1 truncate">{t(lang, 'plens_no_intervencions')}</span>
                </a>
              );
            }
          })}
        </div>
      </section>
    );
  })}
</Base>

<script>
  const btn = document.getElementById('toggle-empty') as HTMLButtonElement | null;
  if (btn) {
    const emptyRows = document.querySelectorAll<HTMLElement>('[data-empty="true"]');
    btn.addEventListener('click', () => {
      const next = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(next));
      if (next) {
        btn.classList.add('bg-orange-50', 'border-orange-400', 'text-orange-700');
        btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-500', 'hover:border-orange-300', 'hover:text-orange-600');
        emptyRows.forEach(r => (r.style.display = 'none'));
      } else {
        btn.classList.remove('bg-orange-50', 'border-orange-400', 'text-orange-700');
        btn.classList.add('border-stone-200', 'bg-white', 'text-stone-500', 'hover:border-orange-300', 'hover:text-orange-600');
        emptyRows.forEach(r => (r.style.display = ''));
      }
    });
  }
</script>
